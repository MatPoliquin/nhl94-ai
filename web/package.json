{
  "name": "nhl94-browser-smoke",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:core": "node scripts/build-core.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/check-core.mjs && npm run typecheck && vite build",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
