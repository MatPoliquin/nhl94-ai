{
  "common": {
    "learning_rate": 0.00025,
    "batch_size": 512,
    "n_steps": 2048,
    "n_epochs": 4,
    "gamma": 0.99,
    "clip_range": 0.2,
    "vf_coef": 0.5,
    "ent_coef": 0.01,
    "max_grad_norm": 0.5,
    "clip_range_vf": null,
    "net_arch": {
      "pi": [512, 512, 256],
      "vf": [512, 512, 256]
    },
    "features_dim": 128,
    "frame_skip": 4,
    "sticky_actions": false,
    "sticky_action_prob": 0.25,
    "clip_reward": false
  },
  "model_overrides": {
    "MlpPolicy": {
      "net_arch": {
        "pi": [128, 128],
        "vf": [128, 128]
      }
    },
    "ResidualMlpPolicy": {
      "residual_mlp": {
        "hidden_dim": 256,
        "num_blocks": 4,
        "head_dim": 256,
        "activation": "relu"
      }
    },
    "HybridMambaPolicy": {
      "learning_rate": 0.0003,
      "batch_size": 64,
      "n_epochs": 10,
      "gae_lambda": 0.95,
      "features_dim": 256,
      "net_arch": {
        "pi": [128, 128],
        "vf": [128, 128]
      },
      "hybrid_mamba": {
        "features_dim": 256,
        "mamba_dim": 128,
        "d_state": 64,
        "d_conv": 4,
        "expand": 2,
        "gru_layers": 2
      }
    },
    "GRUMlpPolicy": {
      "learning_rate": 0.00025,
      "batch_size": 128,
      "n_epochs": 8,
      "gae_lambda": 0.95,
      "features_dim": 384,
      "net_arch": {
        "pi": [256, 256],
        "vf": [256, 256]
      },
      "gru_mlp": {
        "features_dim": 384,
        "hidden_dim": 256,
        "spatial_hidden_dim": 256,
        "gru_layers": 2
      }
    }
  },
  "model_input": "default"
}
