+"""Bounded ordinary carries and defender reach, using native skating updates."""
+from copy import copy
+import math
+
+from nhl94_ai.agents.defense import eligible, on_ice
+from nhl94_ai.agents.motion import (
+    arrival_time, bounded_projection, boost_impulse, burst_velocity, skating, velocity,
+)
+from nhl94_ai.agents.passing import _contact_offsets
+from nhl94_ai.agents.skating import grounded_step
+from nhl94_ai.env.target_control import project_target
+
+
+CARRY_FRAMES = 18
+CONTACT_RADIUS = 16
+INTERCEPTION_MARGIN = 3
+CARRY_SAMPLES = (4, 8, 12, CARRY_FRAMES)
+
+
+def carry_pad(player, target):
+    """The ordinary controller holds these buttons until its next decision."""
+    return tuple(1 if delta > 3 else -1 if delta < -3 else 0
+                 for delta in (target[0] - player.x, target[1] - player.y))
+
+
+def carry_path(player, target, frames=CARRY_FRAMES, *, decision_interval=4):
+    if frames < 0 or decision_interval < 1:
+        raise ValueError('Carry horizons must be nonnegative and decision intervals positive')
+    carrier = copy(player)
+    path = [carrier]
+    for elapsed in range(frames):
+        if elapsed % decision_interval == 0:
+            pad = carry_pad(carrier, target)
+        carrier = grounded_step(carrier, pad)
+        if math.dist((carrier.x, carrier.y), project_target((carrier.x, carrier.y))) > 1e-6:
+            return None
+        path.append(carrier)
+    return path
+
+
+def _segment_clearance(start, end):
+    dx, dy = end[0] - start[0], end[1] - start[1]
+    fraction = max(0, min(1, -(start[0] * dx + start[1] * dy) / max(0.01, dx * dx + dy * dy)))
+    return math.hypot(start[0] + dx * fraction, start[1] + dy * fraction)
+
+
+def interception_time(state, player, point, deadline, *, body=False):
+    """Earliest body/stick reach in neutral and facing-boost pursuit scenarios.
+
+    A capped result is a lower bound, not a promise of a later CPU arrival.
+    Unknown physics retains the older explicitly conservative timing estimate.
+    """
+    deadline = math.ceil(deadline)
+    if not eligible(player):
+        return deadline + 1
+    if any(getattr(player, field) is None
+           for field in ('motion_x', 'motion_y', 'weight', 'agility', 'speed', 'energy')):
+        return min(arrival_time(player, (point[0] - offset[0], point[1] - offset[1]),
+                                optimistic=True, boost=True) for offset in _contact_offsets(player))
+    acceleration, _, _ = skating(player)
+    offsets = ((0, 0),) if body else _contact_offsets(player)
+    contacts = [(offset, (CONTACT_RADIUS if body else 8 if index == 0 else 14)
+                 + player.projection_uncertainty) for index, offset in enumerate(offsets)]
+    reach = max(radius for _, radius in contacts)
+    distance = min(math.dist((player.x + dx, player.y + dy), point) for dx, dy in offsets)
+    if distance > reach + (math.hypot(*velocity(player)) + boost_impulse(player)) * deadline + (
+            acceleration * deadline * (deadline + 1) / 2):
+        return deadline + 1
+    scenarios = [copy(player)]
+    if boost_impulse(player) > 0:
+        boosted = copy(player)
+        boosted.motion_x, boosted.motion_y = burst_velocity(player)
+        boosted.energy = max(0, player.energy - 204)
+        scenarios.append(boosted)
+    earliest = deadline + 1
+    for defender in scenarios:
+        for elapsed in range(deadline + 1):
+            if any(math.dist((defender.x + offset[0], defender.y + offset[1]), point) <= radius
+                   for offset, radius in contacts):
+                earliest = min(earliest, elapsed)
+                break
+            if elapsed >= min(deadline, earliest):
+                break
+            offset = min((math.dist((defender.x + dx, defender.y + dy), point), (dx, dy))
+                         for dx, dy in offsets)[1]
+            target = point[0] - offset[0], point[1] - offset[1]
+            future = grounded_step(defender, carry_pad(defender, target))
+            if any(state._line_intersects_circle(
+                    (defender.x + offset[0], defender.y + offset[1]),
+                    (future.x + offset[0], future.y + offset[1]), point, radius)
+                   for offset, radius in contacts):
+                earliest = min(earliest, elapsed + 1)
+                break
+            defender = future
+    return earliest
+
+
+def forecast_carry(state, player, target, *, decision_interval=4, pressure_state=None, pressure_delay=0):
+    path = carry_path(player, target, decision_interval=decision_interval)
+    details = {
+        'carry_bounded': path is not None, 'carry_safe': False,
+        'carry_clearance': -math.inf, 'carry_pressure': -math.inf,
+        'carry_progress': -math.inf, 'carry_shot_value': 0.0,
+        'carry_pressure_model': 'native-turn-and-facing-boost',
+    }
+    if path is None:
+        return path, details
+    clearance = math.inf
+    obstacles = [other for team in (state.team1, state.team2)
+                 for other in (*team.players, team.goalie) if other is not player and on_ice(other)]
+    for other in obstacles:
+        previous = player.x - other.x, player.y - other.y
+        clearance = min(clearance, math.hypot(*previous) - CONTACT_RADIUS - other.projection_uncertainty)
+        for elapsed, carrier in enumerate(path[1:], 1):
+            position, uncertainty = bounded_projection(other, elapsed, boards=other.role != 0)
+            relative = carrier.x - position[0], carrier.y - position[1]
+            clearance = min(clearance, _segment_clearance(previous, relative) - CONTACT_RADIUS - uncertainty)
+            previous = relative
+    offset = state.puck.x - player.x, state.puck.y - player.y
+    margin = 60.0
+    pressure_state = state if pressure_state is None else pressure_state
+    for elapsed in CARRY_SAMPLES:
+        carrier = path[elapsed]
+        points = (((carrier.x, carrier.y), True),
+                  ((carrier.x + offset[0], carrier.y + offset[1]), False))
+        for other in pressure_state.team2.players:
+            if not on_ice(other):
+                continue
+            if any(getattr(other, field) is None
+                   for field in ('motion_x', 'motion_y', 'weight', 'agility', 'speed', 'energy')):
+                details['carry_pressure_model'] = 'conservative-missing-defender-feedback'
+            for point, body in points:
+                margin = min(margin, interception_time(
+                    pressure_state, other, point, pressure_delay + elapsed + INTERCEPTION_MARGIN, body=body)
+                    - pressure_delay - elapsed)
+    sign = 1 if state.team2.net.y > state.team1.net.y else -1
+    details.update(
+        carry_safe=clearance > 0 and margin >= INTERCEPTION_MARGIN,
+        carry_clearance=clearance, carry_pressure=margin,
+        carry_progress=(path[-1].y - player.y) * sign)
+    return path, details
