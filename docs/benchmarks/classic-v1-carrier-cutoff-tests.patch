+"""Bounded native carrier-route interception; run explicitly with the NHL94 ROM."""
+import argparse
+from contextlib import nullcontext
+import json
+import math
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import numpy as np
+
+from nhl94_ai.agents.classic_v1 import ClassicAIV1Model
+from nhl94_ai.agents.motion import VELOCITY_SCALE, velocity
+from nhl94_ai.env.actions import HockeyActionController
+from nhl94_ai.env.factory import make_retro
+from nhl94_ai.env.target_control import project_target
+from nhl94_ai.evaluation.benchmark import away_view
+from nhl94_ai.game.constants import GameConsts as Buttons
+from nhl94_ai.game.ram import pass_geometry_info
+from nhl94_ai.game.state import NHL94GameState
+from nhl94_ai.tasks.defense_setup import (
+    _place_object, _rebuild_object_order, _reset_player, init_full_team_defense,
+)
+
+
+def _setup(env, side, position, motion, heading):
+    init_full_team_defense(env)
+    memory = env.data.memory
+    original = memory.extract(0xFFC320, '>i2')
+    receiver = memory.extract(0xFFB7AA, '>i2') - 6
+    actual, carrier = original + (side - 1) * 6, receiver + (2 - side) * 6
+    sign = -1 if side == 1 else 1
+    for slots, friendly in ((range(5), side == 1), (range(6, 11), side == 2)):
+        remote = [slot for slot in slots if slot not in (actual, carrier)]
+        for index, slot in enumerate(remote):
+            role = memory.extract(0xFFB04A + slot * 0x80 + 0x34, '>i2')
+            assignment = (2 if friendly else 1) if role in (1, 2) else (
+                (5 if friendly else 6) if role == 4 else (3 if friendly else 4))
+            _reset_player(memory, slot, (-100 + index * 65, -sign * (150 if friendly else 200)),
+                          0, assignment, False)
+    for slot, point, facing, temporary in (
+            (actual, (position[0], sign * position[1]),
+             heading if side == 1 else (4 - heading) % 8, (0x11,)),
+            (carrier, (0, 0), 3 if side == 1 else 1, (0x10, 0x11))):
+        role = memory.extract(0xFFB04A + slot * 0x80 + 0x34, '>i2')
+        assignment = (1 if slot == carrier else 2) if role in (1, 2) else (
+            (6 if slot == carrier else 5) if role == 4 else (4 if slot == carrier else 3))
+        _reset_player(memory, slot, point, facing, assignment, True, temporary)
+        base = 0xFFB04A + slot * 0x80
+        for offset, value in ((0x67, 32 if slot == actual else 64), (0x68, 30),
+                              (0x69, 30 if slot == actual else 16), (0x71, 20)):
+            memory.assign(base + offset, '|u1', value)
+        roster = memory.extract(base + 0x66, '|u1')
+        memory.assign(0xFFC700 + (slot // 6) * 0x364 + roster * 2, '>u2', 4096)
+    memory.assign(0xFFB04A + carrier * 0x80 + 0x28, '>i2', round(0.75 / VELOCITY_SCALE))
+    memory.assign(0xFFB04A + carrier * 0x80 + 0x2A, '>i2', round(sign * 1.3 / VELOCITY_SCALE))
+    memory.assign(0xFFB04A + actual * 0x80 + 0x28, '>i2', round(motion[0] / VELOCITY_SCALE))
+    memory.assign(0xFFB04A + actual * 0x80 + 0x2A, '>i2', round(sign * motion[1] / VELOCITY_SCALE))
+    for address, value in ((0xFFC320, actual), (0xFFC322, carrier),
+                           (0xFFC328, side), (0xFFC32A, 3 - side),
+                           (0xFFB7AA, carrier), (0xFFBEDA, carrier), (0xFFBEE0, -1)):
+        memory.assign(address, '>i2', value)
+    _place_object(memory, 14, (0, 0))
+    _rebuild_object_order(memory)
+    env.data.update_ram()
+    return actual, carrier
+
+
+def capture(schema, side, cutoffs, *, position=(50, 40), motion=(0, 0), heading=5):
+    env = make_retro(game='NHL94-Genesis-v0', state='PenguinsVsSenators.DefenseZone', num_players=2)
+    try:
+        env.reset(seed=7)
+        actual, carrier = _setup(env, side, position, motion, heading)
+        model = ClassicAIV1Model(SimpleNamespace(action_type=schema))
+        context = SimpleNamespace(action_type=schema)
+        processor = HockeyActionController(context)
+        macro = processor._new_action_state()
+        state = NHL94GameState(5)
+        trace = []
+
+        def original_lane(view, slot, player):
+            vx, vy = velocity(player)
+            threat = project_target((player.x + vx * 8, player.y + vy * 8))
+            return model.defense._lane(view, threat, slot, check_receivers=True)
+
+        ablation = nullcontext() if cutoffs else patch.object(
+            model.defense, '_carrier_plan', side_effect=original_lane)
+        with ablation:
+            for frame in range(64):
+                info = pass_geometry_info(env, env.data.lookup_all())
+                state.BeginFrame(info, [0] * 6)
+                view = state if side == 1 else away_view(state)
+                context.game_state = view
+                player = view.team1.get_player_by_scnum(actual)
+                opponent = view.team2.get_player_by_scnum(carrier)
+                action = model.predict_frame(view)[0]
+                details = model.defense_diagnostics
+                trace.append({
+                    'frame': frame, 'owner': view.engine.puck_owner,
+                    'defender': [player.x, player.y], 'carrier': [opponent.x, opponent.y],
+                    'distance': math.dist((player.x, player.y), (opponent.x, opponent.y)),
+                    'goal_side': (player.y - opponent.y) * (-1 if side == 1 else 1) >= 0,
+                    'contact_player': opponent.contact_player,
+                    'bodychecks': view.team1.stats.bodychecks,
+                    'decision': details.get('decision'), 'mode': details.get('mode'),
+                    'target': details.get('target'), 'carrier_arrival': details.get('carrier_arrival'),
+                })
+                if view.engine.puck_owner != carrier:
+                    break
+                if schema == 'HOCKEY_INTENT_DPAD':
+                    action = processor._process_action(action, macro)[0]
+                opponent_action = np.zeros(12, dtype=np.int8)
+                opponent_action[Buttons.INPUT_RIGHT] = 1
+                opponent_action[Buttons.INPUT_DOWN if side == 1 else Buttons.INPUT_UP] = 1
+                env.step(np.concatenate((action, opponent_action)))
+                state.EndFrame()
+        return {'schema': schema, 'side': side, 'cutoffs': cutoffs,
+                'initial_position': position, 'initial_motion': motion, 'initial_heading': heading,
+                'actual_slot': actual, 'carrier_slot': carrier, 'trace': trace}
+    finally:
+        env.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output')
+    args = parser.parse_args()
+    results = []
+    scenarios = {
+        'missed-cutoff': {'position': (20, 50), 'heading': 7},
+        'existing-contact': {'position': (50, 40), 'heading': 5},
+        'unreachable-pursuit': {'position': (0, -24), 'heading': 4},
+    }
+    for schema in ('FILTERED', 'HOCKEY_INTENT_DPAD'):
+        for side in (1, 2):
+            for scenario, settings in scenarios.items():
+                before, after = (capture(schema, side, False, **settings),
+                                 capture(schema, side, True, **settings))
+                pair = before, after
+                for result in pair:
+                    result['scenario'] = scenario
+                    results.append(result)
+                    assert result['trace'][0]['owner'] == result['carrier_slot'], result
+                old_contacts = [row for row in before['trace']
+                                if row['contact_player'] == before['actual_slot']]
+                contacts = [row for row in after['trace']
+                            if row['contact_player'] == after['actual_slot']]
+                if scenario == 'missed-cutoff':
+                    assert not old_contacts, before
+                    assert before['trace'][-1]['owner'] == before['carrier_slot'], before
+                    assert any(row['decision'] == 'intercept-carrier' for row in after['trace']), after
+                    assert contacts and contacts[0]['goal_side'], after
+                    assert abs(contacts[0]['carrier'][1]) < 88, contacts[0]
+                    assert after['trace'][-1]['owner'] != after['carrier_slot'], after
+                elif scenario == 'existing-contact':
+                    assert old_contacts and contacts, pair
+                else:
+                    assert not old_contacts and not contacts, pair
+                    assert after['trace'][0]['decision'] == 'retreat-lane', after
+                    for row in after['trace']:
+                        if row['decision'] == 'retreat-lane':
+                            assert abs(row['target'][1]) == 120 and row['carrier_arrival'] is None, row
+                print(f'PASS: {schema}, AI side {side}, {scenario}: '
+                      f'contact frame {contacts[0]["frame"] if contacts else None}; '
+                      'native contact/ownership and unreachable fallback verified')
+    for before, after in zip(results[:12], results[12:]):
+        assert before['trace'] == after['trace'], (before['scenario'], before['side'])
+    if args.output:
+        path = Path(args.output)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps(results, indent=2) + '\n', encoding='utf-8')
+
+
+if __name__ == '__main__':
+    main()
