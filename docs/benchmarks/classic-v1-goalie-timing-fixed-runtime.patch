+                                      ('one_timer_goals', one_timer_goals, self.one_timer_goals)):
+            if value > previous:
+                self.events.append({**self.context, 'counter': name, 'delta': value - previous})
+        self.score, self.one_timer_goals = score, one_timer_goals
+
+    def summary(self):
