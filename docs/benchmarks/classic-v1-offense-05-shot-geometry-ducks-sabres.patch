+def coast_projection(player, frames):
+    """ShotMode uses aim, not skating acceleration; retain existing inertia."""
+    x, y = float(player.x), float(player.y)
+    vx, vy = velocity(player)
+    for _ in range(frames):
+        vx, vy = vx * 63 / 64, vy * 63 / 64
+        x, y = x + vx, y + vy
+    return x, y
 
 
