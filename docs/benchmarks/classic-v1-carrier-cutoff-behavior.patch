+            return None
+        player = next((player for number, player in candidates if number == request.defender_slot), None)
+        vx, vy = velocity(carrier)
+        remaining = request.deadline - self.frames
+        forecast = carrier.x + vx * max(0, remaining), carrier.y + vy * max(0, remaining)
+        arrived = player is not None and math.dist((player.x, player.y), request.target) <= 7
+        timely = player is not None and (
+            arrived or self._cost(state, request.defender_slot, player, request.target) + CUTOFF_MARGIN <= remaining)
+        if (request.carrier_slot == slot and remaining >= -CUTOFF_MARGIN
+                and math.dist(forecast, request.point) <= CUTOFF_GAP and timely):
+            return replace(lane, target=request.target, mode='intercept-carrier',
+                           reason='retain reachable cutoff; do not move its deadline ahead of carrier',
+                           carrier_arrival=max(0, remaining), carrier_point=request.point,
+                           cutoff_slot=request.defender_slot)
+        self.carrier_cutoff = None
+        self.cutoff_retry_at = self.frames + SWITCH_INTERVAL if request.carrier_slot == slot else self.frames
+        return None
